# Copy to .env (never commit .env).

# Port the server listens on (serves the web app and the /ws relay)
PORT=28787

# Optional: comma-separated list of allowed Origin headers for WebSocket connections.
# Empty = accept any origin. Example: https://mimepool.example.com
ALLOWED_ORIGINS=

# Optional usage analytics: a GA4 measurement id (G-XXXXXXXXXX) or a Tag Manager container (GTM-XXXXXXX).
# The server writes it into the page it serves; empty = analytics off. It is never stored in the repository.
GA_MEASUREMENT_ID=

# --- Docker Compose only ---
# Image to run. The CI sets this on the server at each deploy; leave empty for a local build.
IMAGE=
# Token of a dashboard-managed Cloudflare Tunnel, only for `docker compose --profile tunnel`.
TUNNEL_TOKEN=
